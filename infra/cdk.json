{
  "app": "npx ts-node --prefer-ts-exts bin/triageops.ts",
  "watch": { "include": ["**"], "exclude": ["cdk.out", "node_modules", "test"] },
  "context": {
    "classifyModelId": "us.amazon.nova-lite-v1:0",
    "draftModelId": "us.amazon.nova-pro-v1:0",
    "embedModelId": "amazon.titan-embed-text-v2:0",
    "confidenceThreshold": "0.7",
    "duplicateThreshold": "0.85",
    "promptCache": "false",
    "alarmEmail": "",
    "githubRepo": "",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true
  }
}
